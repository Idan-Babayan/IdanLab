---
// src/components/Callout.astro
//
// Presentational tagged callout (same spirit as Toggle.astro): a 3px accent left border, a faint
// accent tint, and a header row of icon + UPPERCASE label in the accent color. All colors live in
// components.css (.cl / .cl-<type>, @layer components). Markdown inside the slot renders, so authors can write inline
// `code`, lists, and links.
//
// The root is a <div>, not an <aside>. An <aside> inside <main> is a complementary landmark, so a
// writeup's callouts (six on Busqueda) each landed in a screen reader's landmarks list, unnamed, and
// each was announced as "complementary" on entry. They are the writeup's own content (recon findings,
// loot), not a side note, and Firefox's Reader View drops every <aside>, callouts included. As a div,
// a screen reader reads the visible label first ("recon"), then the box, as a sighted reader sees it.
// Not role="note" (announced inconsistently) or role="group" (adds "grouping" to every box), and not
// aria-labelledby on an aside, which reads the label twice. Principle.astro stays an <aside>, named.

type CalloutType = 'recon' | 'loot' | 'intel' | 'defense' | 'vuln';

interface Props {
  type: CalloutType;
  label?: string;
}

const { type, label } = Astro.props;
const text: string = label ?? type;

// One glyph family for the five callouts, drawn for the site in place of Starlight's icons: a 24 grid,
// 2-unit lines, sharp joins and solid accents, all in currentColor so --acc and --cl-ink keep colouring
// them in both themes. recon binoculars, loot gem, intel info mark, vuln bug, defense half-filled shield.
// The strings are static markup authored here, never user input, so set:html is safe. `as const
// satisfies` keeps the map exhaustive over CalloutType.
const GLYPHS = {
  recon: '<path d="M3 16.25 4.5 7.5H9l1.5 8.75M13.5 16.25 15 7.5h4.5L21 16.25"/><circle cx="6.75" cy="16.25" r="3.75"/><circle cx="17.25" cy="16.25" r="3.75"/><path fill="currentColor" stroke="none" d="M5.25 3.5h3v4h-3zM15.75 3.5h3v4h-3zM9.75 9.75h4.5v3.5h-4.5z"/>',
  loot: '<path d="M6.5 4h11L22 9.5 12 21 2 9.5z"/><path d="M2 9.5h20M6.5 4 9 9.5M17.5 4 15 9.5"/><path fill="currentColor" stroke="none" d="M9 9.5h6L12 21z"/>',
  intel: '<circle cx="12" cy="12" r="9"/><circle fill="currentColor" stroke="none" cx="12" cy="7.75" r="1.6"/><path fill="currentColor" stroke="none" d="M10.75 10.5h2.5V17h-2.5z"/>',
  vuln: '<path d="M12 7.5a5 6.5 0 1 1 0 13 5 6.5 0 1 1 0-13z"/><path fill="currentColor" stroke="none" d="M9 7.5a3 3 0 0 1 6 0z"/><path d="M12 9.5V20M7.8 10.5 4 7.5M7 14H2.5M7.8 17.5 4 20.5M16.2 10.5 20 7.5M17 14h4.5M16.2 17.5 20 20.5"/>',
  defense: '<path d="M12 2.5 20 5.5v6c0 4.8-3.3 8.4-8 10-4.7-1.6-8-5.2-8-10v-6z"/><path fill="currentColor" stroke="none" d="M12 2.5v19c-4.7-1.6-8-5.2-8-10v-6z"/>',
} as const satisfies Record<CalloutType, string>;
---

<div class={`cl cl-${type}`}>
  <p class="cl-header">
    <svg class="cl-icon" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="miter" stroke-linecap="butt" aria-hidden="true" set:html={GLYPHS[type]} />
    <span class="cl-label">{text}</span>
  </p>
  <slot />
</div>
