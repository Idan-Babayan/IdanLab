---
// src/components/ToggleAll.astro
//
// A dependency-free "Expand all / Collapse all" control for a writeup's content toggles. It is
// injected at the BOTTOM of the right "On this page" sidebar by the PageSidebar override, as a
// standalone utility set apart from the TOC list by whitespace (clearly interactive, not a TOC entry).
// It targets only the <details class="toggle"> rendered by
// Toggle.astro (and PasswordReveal's block mode), scoped to .sl-markdown-content, so it never touches
// the sidebar, the nav or code-block details.
//
// The wrapper starts hidden and the script reveals it only when a page has two or more content
// toggles, so there is no dead button without JS, no empty control on a page that has no toggles, and
// no bulk control on a single-toggle page (where expand/collapse-all adds nothing over the lone
// toggle). Expand/collapse pins the reader's line (the first line under the fixed header) and corrects
// scroll so the page does not teleport: every toggle above that line opens or closes out of view.
---

<div class="toggle-all-wrap" hidden>
  <button type="button" class="toggle-all" data-toggle-all aria-label="Expand all toggles">
    <span class="ta-label">Expand all</span>
    <svg
      class="ta-chev"
      viewBox="0 0 24 24"
      width="14"
      height="14"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M6 9l6 6 6-6" />
    </svg>
  </button>
</div>

<script>
  // Reflect the bulk state on a button: expanded=true means every toggle is open. The name carries the
  // NEXT action, like any action button, so there is no aria-pressed: paired with a name that flips,
  // it announced "Collapse all toggles, pressed" with everything open, the opposite of the truth.
  function setExpanded(btn: HTMLButtonElement, expanded: boolean): void {
    const label = btn.querySelector('.ta-label') as HTMLElement | null;
    if (label) label.textContent = expanded ? 'Collapse all' : 'Expand all';
    btn.setAttribute('aria-label', expanded ? 'Collapse all toggles' : 'Expand all toggles');
    btn.classList.toggle('is-collapse', expanded); // chevron points up when everything is open
  }

  // Only the writeup's own toggles: <details class="toggle"> inside the main content (Toggle and
  // PasswordReveal's block mode). Flags are FlagCapture controls, not toggles, so expand-all can never
  // reveal one.
  function contentToggles(): HTMLDetailsElement[] {
    const scope = document.querySelector('.sl-markdown-content');
    if (!scope) return [];
    return Array.from(scope.querySelectorAll('details.toggle')) as HTMLDetailsElement[];
  }

  // The reader's line: the top edge of the readable area, directly under the fixed header. This is the
  // line that must not move. Measured live, so it follows the header's real height.
  function readingLine(): number {
    const header = document.querySelector('header.header');
    return header instanceof HTMLElement ? header.getBoundingClientRect().bottom : 0;
  }

  // Where a toggle lands when the reader was inside it and it closes: the same offset Starlight gives a
  // heading reached from the TOC (the root's scroll-padding-top), so it reads like a normal arrival.
  function landingLine(): number {
    const pad = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop);
    return Number.isFinite(pad) ? pad : readingLine();
  }

  // An element's laid-out children, in document order. display:contents wrappers have no box of their
  // own, so their children stand in for them; elements with no box and out-of-flow ones (the heading
  // anchor icon) are skipped. A CLOSED toggle offers only its summary: its body sits under the UA's
  // content-visibility:hidden, and Chromium still answers geometry queries there by forcing a layout,
  // so a hidden body would otherwise report a position and could be picked as the anchor.
  function boxedChildren(parent: Element): Element[] {
    const out: Element[] = [];
    const kids =
      parent instanceof HTMLDetailsElement && !parent.open
        ? Array.from(parent.children).filter((c) => c instanceof HTMLElement && c.localName === 'summary')
        : Array.from(parent.children);
    for (const child of kids) {
      const style = getComputedStyle(child);
      if (style.display === 'contents') {
        out.push(...boxedChildren(child));
        continue;
      }
      if (style.position === 'absolute' || style.position === 'fixed') continue;
      if (child.getClientRects().length === 0) continue;
      out.push(child);
    }
    return out;
  }

  // The element to pin: the first one, in document order, that either starts at or below the reading
  // line, or crosses it with nothing inside it about to change size. Pinning such an element pins every
  // line inside it. A crossing element that DOES hold a changing toggle is searched inside instead; if
  // the line only grazes it (a toggle's padding peeking out under the header, the summary already
  // above), the search moves on past it, so its change happens above the reader, out of view.
  function anchorAtLine(scope: Element, line: number, changing: ReadonlySet<HTMLDetailsElement>): Element | null {
    const changes = (el: Element): boolean => {
      for (const d of changing) if (el === d || el.contains(d)) return true;
      return false;
    };
    const visit = (parent: Element): Element | null => {
      for (const child of boxedChildren(parent)) {
        const r = child.getBoundingClientRect();
        if (r.bottom <= line) continue; // wholly above the line
        if (r.top >= line || !changes(child)) return child;
        const inner = visit(child);
        if (inner !== null) return inner;
      }
      return null;
    };
    return visit(scope);
  }

  // On collapse, an anchor inside a closing toggle's BODY loses its boxes. Return the OUTERMOST closing
  // toggle that swallows it (its card survives, title showing), or null when the anchor survives. A
  // toggle's own summary stays visible when it closes, so it never swallows its own title text.
  function swallowingToggle(el: Element, closing: ReadonlySet<HTMLDetailsElement>): HTMLDetailsElement | null {
    let outer: HTMLDetailsElement | null = null;
    let d: HTMLDetailsElement | null = el.parentElement?.closest('details') ?? null;
    while (d !== null) {
      const summary = d.querySelector(':scope > summary');
      if (closing.has(d) && !(summary !== null && summary.contains(el))) outer = d;
      d = d.parentElement?.closest('details') ?? null;
    }
    return outer;
  }

  function initToggleAll(): void {
    const buttons = Array.from(document.querySelectorAll('[data-toggle-all]')) as HTMLButtonElement[];
    buttons.forEach((btn) => {
      if (btn.dataset.taReady === 'true') return; // avoid double-binding on the same element
      btn.dataset.taReady = 'true';

      const wrap = btn.closest('.toggle-all-wrap') as HTMLElement | null;
      const toggles = contentToggles();
      if (toggles.length < 2) {
        if (wrap) wrap.hidden = true; // a bulk control adds nothing with 0 or 1 toggle, stay hidden
        return;
      }
      if (wrap) wrap.hidden = false;
      setExpanded(btn, toggles.every((d) => d.open));

      btn.addEventListener('click', () => {
        const current = contentToggles();
        const opening = current.some((d) => !d.open); // mixed or all closed expands; all open collapses
        const changing = new Set(current.filter((d) => d.open !== opening));
        const scope = document.querySelector('.sl-markdown-content');

        // Pin the reader's line BEFORE anything moves. With the line past the last content block (the
        // pager in view), the content's bottom edge is the pin, so what is on screen holds still.
        const line = readingLine();
        let anchor: Element | null = scope ? anchorAtLine(scope, line, changing) : null;
        let edge: 'top' | 'bottom' = 'top';
        if (anchor === null && scope !== null) {
          anchor = scope;
          edge = 'bottom';
        }
        const edgeOf = (el: Element): number => {
          const r = el.getBoundingClientRect();
          return edge === 'top' ? r.top : r.bottom;
        };
        let target = anchor ? edgeOf(anchor) : 0;
        if (anchor && edge === 'top' && !opening) {
          const swallow = swallowingToggle(anchor, changing);
          if (swallow) {
            anchor = swallow; // the reader's text was inside this toggle: land its card in view, title first
            target = landingLine();
          }
        }

        // Suppress the browser's NATIVE scroll anchoring for just this operation, so the correction below
        // is the only one (an engine that applied its own after this task would correct twice). Set on
        // document.documentElement (the viewport scroller).
        const scroller = document.documentElement;
        scroller.style.setProperty('overflow-anchor', 'none');

        changing.forEach((d) => {
          d.open = opening;
        });
        setExpanded(btn, opening);

        // Reading getBoundingClientRect forces the reflow, so this is the post-change position. Correct by
        // the difference synchronously (same task, no rAF): the reader never sees an intermediate frame.
        // Two-arg scrollBy is instant here (writeup pages have no smooth scroll-behavior).
        if (anchor) {
          const delta = edgeOf(anchor) - target;
          if (delta !== 0) window.scrollBy(0, delta);
        }

        // Restore native anchoring on the NEXT frame, so normal reading (late-loading content above the
        // viewport) still benefits from it.
        requestAnimationFrame(() => {
          scroller.style.removeProperty('overflow-anchor');
        });
      });
    });
  }

  initToggleAll();
  // Keep working if View Transitions are ever added (module scripts do not re-run on navigation).
  document.addEventListener('astro:page-load', initToggleAll);
</script>

<style>
  /* Standalone secondary utility at the BOTTOM of the right "On this page" column. Separation comes
     from a gap above plus a subtle theme-matched hairline divider (Starlight's --sl-color-hairline),
     then padding down to the button, so it reads as a utility set apart from the TOC list, not another
     TOC entry. Normal document flow, relative units only (no fixed/absolute). The divider spans the
     column; the button (styled below, unchanged) is inset to align with the TOC content. Both themes. */
  .toggle-all-wrap {
    display: flex;
    justify-content: flex-start;
    margin: 2.5rem 0 0;
    padding: 1rem var(--sl-sidebar-pad-x, 1rem) 0.75rem;
    border-top: 1px solid var(--sl-color-hairline);
  }
  .toggle-all-wrap[hidden] {
    display: none;
  }
  .toggle-all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.32rem 0.7rem;
    font-family: var(--sl-font-mono, ui-monospace, monospace);
    font-size: 0.78rem;
    line-height: 1;
    /* Focus ring: route through the site's --focus-ring token (see the focus-ring system block at the top
       of tokens.css; the rule itself is in base.css) instead of drawing a local outline, so the shared zero-specificity
       :where(...button...):focus-visible rule paints it at the standard 2px / 2px offset. The control's
       identity IS this cyan (its hover color, border and wash all read --pf-accent-2), so the ring echoes
       what it already expresses. --pf-accent-2 is ALREADY theme-aware (:root maps it to --tp-cyan, the
       light block to --tp-cyan-ink), so this one declaration covers both themes with no light variant.
       A custom property set directly on the element wins over :root inheritance regardless of Astro's
       :where() scoping. */
    --focus-ring: var(--pf-accent-2);
    color: var(--sl-color-gray-2);
    background: transparent;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 7px;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }
  .toggle-all:hover,
  .toggle-all:focus-visible {
    color: var(--pf-accent-2);
    border-color: color-mix(in oklab, var(--pf-accent-2) 55%, transparent);
    background: color-mix(in oklab, var(--pf-accent-2) 8%, transparent);
  }
  .ta-chev {
    flex: none;
    transition: transform 0.18s ease;
  }
  .toggle-all.is-collapse .ta-chev {
    transform: rotate(180deg);
  }
  /* Reduced motion: swap the chevron instantly, no rotation animation. */
  @media (prefers-reduced-motion: reduce) {
    .toggle-all,
    .ta-chev {
      transition: none;
    }
  }
</style>
