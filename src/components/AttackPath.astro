---
// src/components/AttackPath.astro
//
// AttackPath: a guided, interactive infographic that tells the story of a LINEAR privilege-escalation
// chain. Reusable across multi-hop writeups (Forest is instance one). It renders an ascending
// horizontal path whose nodes ESCALATE in width and type scale toward the goal, with STRUCTURAL
// directional connectors (each departs one node and arrows INTO the next, the technique riding on
// the segment), a guided "Next step" progression (past = established, present = focal, future = quiet),
// motion that communicates the change and then settles calm, and a one-time gold flourish on reaching
// the goal. Linear chains only: one spine, no branching.
//
// TOKENS (verified against the src/styles/ modules, not assumed; the .pf-* accent token lives in pages.css):
//   - Accent: --pf-accent is NOT global, it is only defined on the .pf-* classes, so this reads
//     var(--pf-accent, var(--sl-color-text-accent)). Dropped into a .pf-* context it inherits that
//     platform's colour; anywhere else it is the site lime. Same fallback idiom as PlatformIndex.
//   - Gold: --flag-gold is DECORATIVE (only 2.00:1 on paper, per DECISIONS 2026-07-13), so it paints
//     borders, glows, the runner and the bloom, while every gold TEXT run uses the AA-grade
//     --flag-gold-val. That split is the whole reason both tokens exist; do not collapse them.
//   - Fonts: --sl-font-mono (JetBrains Mono) and --tp-display (Syne, the real name; there is no
//     --display). Syne ships only 600/700/800, so display type never asks for a lighter weight.
//
// STYLES are scoped to this component and the root carries `not-content`, the majority convention for a
// content-embedded component here (NotFound / WriteupCard / PlatformIndex / SecretTerminal). Astro
// scopes with :where() at specificity 0, which is safe precisely BECAUSE not-content makes every
// .sl-markdown-content prose rule skip this subtree; nothing here needs to out-rank a global rule.

// The dossier's detail labels are one small shared vocabulary, so the label column reads the same from
// tile to tile and only the values change as the reader climbs. `role` describes the entry and belongs
// to it alone; the rest go anywhere. The runtime guard below enforces the set.
type RowLabel = 'role' | 'flaw' | 'how' | 'gain' | 'flag';

interface AttackNode {
  kind: string;                          // short category, e.g. "User", "Group", "Domain", "Root"
  name: string;                          // the principal/object, e.g. "svc-alfresco", "SYSTEM"
  edge?: string;                         // the hop INTO this node, a noun phrase that reads after "via"; may contain <b>. Omit on the first.
  detail?: { k: RowLabel; v: string }[]; // dossier rows; v may contain inline <code>
}

interface Props {
  title?: string;
  nodes: AttackNode[];
}

const { title = 'Attack Path', nodes } = Astro.props;

// The dossier's label for the edge row, the one label the component writes itself.
const EDGE_LABEL = 'via';
// The detail rows' shared vocabulary (see RowLabel above), in the order a tile usually reads.
const ROW_LABELS: readonly RowLabel[] = ['role', 'flaw', 'how', 'gain', 'flag'];

// Runtime guard, matching how WriteupMeta guards its props: `astro build` does not type-check .astro
// props and this repo deliberately has no `astro check`, so the interface above is editor-only. A
// malformed chain would otherwise ship silently as a broken or half-empty graphic.
if (!Array.isArray(nodes) || nodes.length < 2) {
  throw new Error('AttackPath requires an ordered array of at least 2 nodes.');
}
nodes.forEach((n, i) => {
  if (!n || typeof n.kind !== 'string' || !n.kind.trim() || typeof n.name !== 'string' || !n.name.trim()) {
    throw new Error(`AttackPath: node ${i} needs a non-empty "kind" and "name".`);
  }
  if (n.detail && !Array.isArray(n.detail)) {
    throw new Error(`AttackPath: node ${i} "detail" must be an array of { k, v } rows.`);
  }
  // "via" belongs to the edge row. A detail row keyed "via" beside an edge printed the label twice in one
  // panel, and on a node without an edge it wore a detail row's ink where every other panel's "via" is
  // quiet, so the key is reserved outright. Key the row by what it holds.
  if (n.detail?.some((r) => typeof r?.k === 'string' && r.k.trim().toLowerCase() === EDGE_LABEL)) {
    throw new Error(`AttackPath: node ${i} has a detail row keyed "${EDGE_LABEL}", which is reserved for the edge row. Key the row by what it holds.`);
  }
  // One vocabulary for every panel, so the label column stands still while the values change. `role` is
  // the entry's alone: every later node is already introduced by its kind, its name and its `via` row.
  n.detail?.forEach((r) => {
    const k = typeof r?.k === 'string' ? r.k.trim().toLowerCase() : '';
    if (!(ROW_LABELS as readonly string[]).includes(k)) {
      throw new Error(`AttackPath: node ${i} has a detail row keyed "${String(r?.k)}". Key every row from the shared set: ${ROW_LABELS.join(', ')}.`);
    }
    if (k === 'role' && i !== 0) {
      throw new Error(`AttackPath: node ${i} has a "role" row, which belongs to the entry (node 0) alone. Use flaw, how or gain.`);
    }
  });
});

const lastIndex = nodes.length - 1;

// ESCALATION + ASCENT are computed from the node count, never tuned to one chain, so the component reads
// well from a 4-hop chain to a 12-hop one without editing. Two curves, both derived from `lastIndex`:
//
//  - Ascent: aim for a fixed TOTAL climb spread evenly across the hops, then CLAMP the per-hop rise to a
//    sane band. Without the clamp a 2-node chain would climb the whole total in one hop (off the SVG box)
//    and a 12-node chain would inch up invisibly. The clamp keeps any single step readable and any full
//    chain inside a bounded vertical envelope. The headroom padding then reads the ACTUAL total
//    (rise * hops), so the tallest node is never clipped however long the chain runs.
//  - Weight/size: each node carries `--t` = index / lastIndex (0 at entry, 1 at goal), and the width and
//    type-scale interpolate across that in CSS, so the crescendo is proportional to the chain, not a
//    fixed per-node step. See the .ap-node rules.
const RISE_TARGET_TOTAL = 96; // preferred total climb, evenly divided
const RISE_MIN = 12;          // a step never smaller than this (keeps a long chain legible)
const RISE_MAX = 30;          // a step never larger than this (keeps a short chain on the SVG box)
const rise = Math.max(RISE_MIN, Math.min(RISE_MAX, RISE_TARGET_TOTAL / lastIndex));
const climb = rise * lastIndex;

// Connector box geometry, in px. CONN_H comfortably fits the steepest allowed rise (RISE_MAX): the curve
// climbs from y0 = 38 to y1 = 38 - rise, so at the max the arrowhead sits near y 8, still inside the box.
const CONN_W = 124;
const CONN_H = 76;

// One shared path shape for every connector: the box's vertical centre is aligned to the LEFT node's
// centre (both are flex-centred and carry the same `bottom` offset), so the target node's centre sits
// exactly `rise` higher, at y1. The curve therefore always departs a node edge and lands on a node
// edge, and the arrowhead can never point at empty space.
const y0 = CONN_H / 2;
const y1 = y0 - rise;
// The tip overshoots the box's right edge (paired with the connector's negative inline margin below) so
// the stroke reaches the node in EVERY state. A node scales 0.955 while `future`, which pulls its left
// edge inward by (0.045/2 * width), measurably 3 to 4px on this chain; without the overshoot the dashed
// segment visibly falls short of the node it points at.
const CURVE = `M 3 ${y0} C ${CONN_W * 0.45} ${y0}, ${CONN_W * 0.55} ${y1}, ${CONN_W - 2} ${y1}`;
const ARROW = `M ${CONN_W - 10} ${y1 - 5.5} L ${CONN_W - 2} ${y1} L ${CONN_W - 10} ${y1 + 5.5}`;
// Generous enough to exceed the real path length, so dashoffset:<len> hides the stroke completely and
// dashoffset:0 reveals it. A constant avoids a getTotalLength() measurement pass in JS.
const DASH = 260;

// Edge-label tilt. The edge label rides PARALLEL to its connector's chord, at a constant gap above it,
// so its distance to the line stops depending on the three things that made a horizontally-centred label
// read unevenly across the path: the segment's slope, the label's width, and how many lines it wraps to.
// (Measured on the old rule: a 110px horizontal label cleared the line by +17px on the low-left but
// CROSSED it by -2px on the high-right, and a two-line label floated ~8px further off than a one-line
// one.) The chord runs from the curve's start (3, y0) to its end tip (CONN_W-2, y1), so its rise-over-run
// is the angle; negative because the line climbs to the right (screen-up is a CCW rotation). One value
// serves every connector because they all share `rise`, and it is derived, so it holds at any chain length.
const EDGE_ANGLE = -(Math.atan2(rise, CONN_W - 5) * 180 / Math.PI);

// Each node's position along the chain, 0 at the entry and 1 at the goal, driving the width and
// type-scale interpolation in CSS. Rounded because the raw quotient serialises as up to 17 significant
// digits into every node's style attribute (--t:0.1111111111111111), and 4 decimals is already far below
// one device pixel on the widest thing it drives (0.0001 * 52px of width interpolation).
const t = (i: number): number => (lastIndex === 0 ? 0 : Math.round((i / lastIndex) * 1e4) / 1e4);

// Ids for the title and the keyboard hint, derived from the chain itself, so the build is reproducible and two
// chains on one page never collide.
let hash = 5381;
for (const ch of title + nodes.map((n) => n.name).join('|')) hash = ((hash << 5) + hash + ch.charCodeAt(0)) >>> 0;
const uid = `ap-${hash.toString(36)}`;
---

<div
  class="apath not-content"
  data-attack-path
  role="group"
  aria-labelledby={`${uid}-title`}
  style={`--ap-rise:${rise}px; --ap-climb:${climb}px; --ap-cw:${CONN_W}px; --ap-ch:${CONN_H}px; --ap-dash:${DASH}; --ap-edge-angle:${EDGE_ANGLE}deg;`}
>
  <div class="ap-head">
    {/* A " · " in the title is a visual separator: the dot is aria-hidden and kept out of site search,
        and the words around it are read (CORE_SPEC §8). */}
    <p class="ap-title" id={`${uid}-title`}>{title.split(' · ').map((part, i) => (i === 0 ? part : [' ', <span aria-hidden="true" data-pagefind-ignore>·</span>, ` ${part}`]))}</p>
    <div class="ap-meter">
      {/* The step count is real TEXT, so the position is available to assistive tech without a
          role=progressbar dance. The dots below already draw progress, so there is no bar beside it. */}
      <p class="ap-meter-text">Step <span data-ap-step>1</span> of {nodes.length}</p>
    </div>
  </div>

  {/* Inert until the script wires it: without JavaScript the strip is a picture, not seven
      buttons that do nothing, and the dossier below lists every hop instead. */}
  <div class="ap-stage" data-ap-stage inert>
    <div class="ap-track" data-ap-track>
      <div class="ap-spine" data-ap-spine>
        {nodes.map((node, i) => (
          <Fragment>
            {i > 0 && (
              <div
                class:list={['ap-conn', { 'is-goal-conn': i === lastIndex }]}
                data-ap-conn
                data-state="future"
                style={`--i:${i - 1}`}
              >
                <svg class="ap-conn-svg" width={CONN_W} height={CONN_H} viewBox={`0 0 ${CONN_W} ${CONN_H}`} aria-hidden="true">
                  {/* Quiet dashed segment: the path not yet taken. Always present. */}
                  <path class="ap-conn-base" d={CURVE} />
                  {/* Solid segment + arrowhead: drawn in when the hop becomes `done`. */}
                  <path class="ap-conn-live" d={CURVE} />
                  <path class="ap-conn-head" d={ARROW} />
                </svg>
                {node.edge && <span class="ap-edge" set:html={node.edge} />}
              </div>
            )}
            <button
              type="button"
              class:list={['ap-node', { 'is-start': i === 0, 'is-goal': i === lastIndex }]}
              data-ap-node
              data-state={i === 0 ? 'active' : 'future'}
              aria-current={i === 0 ? 'step' : undefined}
              aria-describedby={`${uid}-hint`}
              style={`--i:${i}; --t:${t(i)}; --ap-nw:${t(i) >= 0.5 ? 700 : 500}`}
            >
              <span class="ap-node-kind">{node.kind}</span>
              <span class="ap-node-name">{node.name}</span>
              {/* Non-colour cue for `done`, so state is never carried by hue alone. */}
              <svg class="ap-check" viewBox="0 0 24 24" width="13" height="13" fill="none"
                stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 13l4 4L19 7" />
              </svg>
            </button>
          </Fragment>
        ))}
        <span class="ap-runner" data-ap-runner aria-hidden="true"></span>
      </div>
    </div>
    {/* The "there is more path" affordance: the native scrollbar is hidden and these gradient masks
        dissolve the past on the left while the next node peeks in under the right fade. */}
    <div class="ap-fade ap-fade-l" aria-hidden="true"></div>
    <div class="ap-fade ap-fade-r" aria-hidden="true"></div>
    <p class="ap-hint" id={`${uid}-hint`}>Arrow keys move between steps</p>
  </div>

  <div class="ap-dossier" data-ap-dossier>
    {/* Every panel is one list, head and edge included, so every value in it sits in the same column, and
        all the panels share that column and one stacked cell (see the dossier rules). What tells the rows
        apart is how they look, never where they start. */}
    {nodes.map((node, i) => (
      <dl class:list={['ap-panel', { 'is-goal': i === lastIndex }]} data-ap-panel hidden={i !== 0}>
        <dt class="ap-panel-kind">{node.kind}</dt>
        <dd class="ap-panel-name">{node.name}</dd>
        {node.edge && (
          <Fragment>
            <dt class="ap-panel-via">{EDGE_LABEL}</dt>
            <dd class="ap-panel-edge" set:html={node.edge} />
          </Fragment>
        )}
        {node.detail && node.detail.map((row) => (
          <Fragment>
            <dt>{row.k}</dt>
            <dd set:html={row.v} />
          </Fragment>
        ))}
      </dl>
    ))}
  </div>

  <div class="ap-foot">
    {/* A pointer shortcut and a picture of progress. Keyboard and screen-reader users have the same thing in
        the nodes themselves, so the row stays out of the tab order and the accessibility tree. */}
    <div class="ap-dots" aria-hidden="true">
      {nodes.map((_, i) => (
        <span class="ap-dot" data-ap-dot data-state={i === 0 ? 'active' : 'future'} style={`--t:${t(i)}`}></span>
      ))}
    </div>
    <button type="button" class="ap-next" data-ap-next>
      <svg class="ap-done-ico" viewBox="0 0 24 24" width="14" height="14" fill="none"
        stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 13l4 4L19 7" />
      </svg>
      <span data-ap-next-label>Next step</span>
      <svg class="ap-next-ico" viewBox="0 0 24 24" width="14" height="14" fill="none"
        stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h13M13 6l6 6-6 6" />
      </svg>
    </button>
  </div>
  {/* One composed sentence per step, instead of the whole dossier read as a run-on string. */}
  <p class="sr-only" data-ap-status aria-live="polite"></p>
  {/* Without JavaScript the stepper cannot run, so the dossier lists every hop instead and the controls step
      aside. Inline, so it only exists when scripting is off. */}
  <noscript>
    <style is:inline>
      .apath .ap-meter, .apath .ap-foot { display: none; }
      .apath .ap-panel { grid-area: auto; grid-column: 1 / -1; }
      .apath .ap-panel[hidden] { visibility: visible; user-select: auto; -webkit-user-select: auto; }
      .apath .ap-panel + .ap-panel { margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--ap-line); }
    </style>
  </noscript>
</div>

<script>
  // The site's motion curve, cubic-bezier(0.4, 0.05, 0.2, 1), evaluated in script so the camera, the spark
  // and the line it draws all run on one clock and one curve. Solves x(s) = p for the curve parameter by
  // Newton's method, with bisection as the fallback, then returns y(s), as CSS does.
  function bezier(x1: number, y1: number, x2: number, y2: number): (p: number) => number {
    const cx = 3 * x1;
    const bx = 3 * (x2 - x1) - cx;
    const ax = 1 - cx - bx;
    const cy = 3 * y1;
    const by = 3 * (y2 - y1) - cy;
    const ay = 1 - cy - by;
    const xAt = (s: number): number => ((ax * s + bx) * s + cx) * s;
    const yAt = (s: number): number => ((ay * s + by) * s + cy) * s;
    const slope = (s: number): number => (3 * ax * s + 2 * bx) * s + cx;
    return (p: number): number => {
      if (p <= 0) return 0;
      if (p >= 1) return 1;
      let s = p;
      for (let i = 0; i < 8; i++) {
        const d = slope(s);
        if (Math.abs(d) < 1e-6) break;
        s -= (xAt(s) - p) / d;
      }
      if (!(s >= 0 && s <= 1) || Math.abs(xAt(s) - p) > 1e-5) {
        let lo = 0;
        let hi = 1;
        s = p;
        for (let i = 0; i < 40; i++) {
          if (xAt(s) < p) lo = s;
          else hi = s;
          s = (lo + hi) / 2;
        }
      }
      return yAt(s);
    };
  }
  const ease = bezier(0.4, 0.05, 0.2, 1);
  const clamp01 = (v: number): number => Math.max(0, Math.min(1, v));
  const smoothstep = (a: number, b: number, v: number): number => {
    const x = clamp01((v - a) / (b - a));
    return x * x * (3 - 2 * x);
  };

  // Every instance is wired independently, so a page may carry more than one chain.
  function setupAttackPath(root: HTMLElement): void {
    if (root.dataset.enhanced === 'true') return;
    const nodes = Array.from(root.querySelectorAll('[data-ap-node]')) as HTMLButtonElement[];
    const conns = Array.from(root.querySelectorAll('[data-ap-conn]')) as HTMLElement[];
    const lines = conns.map((c) => c.querySelector('.ap-conn-live') as SVGPathElement | null);
    const dots = Array.from(root.querySelectorAll('[data-ap-dot]')) as HTMLElement[];
    const panels = Array.from(root.querySelectorAll('[data-ap-panel]')) as HTMLElement[];
    const track = root.querySelector('[data-ap-track]') as HTMLElement | null;
    const spine = root.querySelector('[data-ap-spine]') as HTMLElement | null;
    const runner = root.querySelector('[data-ap-runner]') as HTMLElement | null;
    const nextBtn = root.querySelector('[data-ap-next]') as HTMLButtonElement | null;
    const nextLabel = root.querySelector('[data-ap-next-label]') as HTMLElement | null;
    const stepEl = root.querySelector('[data-ap-step]') as HTMLElement | null;
    const status = root.querySelector('[data-ap-status]') as HTMLElement | null;
    if (!nodes.length || !track || !spine || !runner || !nextBtn || lines.some((l) => !l)) return;
    const paths = lines as SVGPathElement[];
    const lens = paths.map((l) => l.getTotalLength());
    const dash = parseFloat(getComputedStyle(root).getPropertyValue('--ap-dash')) || 260;
    root.dataset.enhanced = 'true';
    root.querySelector('[data-ap-stage]')?.removeAttribute('inert');

    const last = nodes.length - 1;
    let pos = 0;
    let bloomed = false; // the goal flourish is one-time; revisiting must never replay it
    let anim: { raf: number; finish: () => void } | null = null;
    let panelTimer = 0;

    // Captured once from the rendered markup, so the accessible names below stay in step with the visible
    // labels without the data being threaded through a second time.
    const text = (el: Element | null): string => (el?.textContent ?? '').replace(/\s+/g, ' ').trim();
    const labels = nodes.map((n) => `${text(n.querySelector('.ap-node-kind'))} ${text(n.querySelector('.ap-node-name'))}`.trim());
    const edges = panels.map((p) => text(p.querySelector('.ap-panel-edge')));

    // Read at interaction time, not once at load, so a mid-session OS change is honoured (the same
    // approach FlagCapture takes).
    const reduced = (): boolean => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Progress state is carried visually by tint, scale and the check glyph, none of which reach assistive
    // tech, so the word is appended to each node's accessible name, after its visible label (WCAG 2.5.3).
    function stateWord(i: number, at: number): string {
      return i < at ? 'completed' : i === at ? 'current step' : 'not yet reached';
    }

    // ── Painting, in two layers: what the reader acts on changes at once (count, dots, names, focus order);
    //    what the strip shows changes as the climb plays (paintStrip). ──
    function paintChrome(at: number): void {
      nodes.forEach((n, i) => {
        if (i === at) n.setAttribute('aria-current', 'step');
        else n.removeAttribute('aria-current');
        n.setAttribute('aria-label', `${labels[i]}, ${stateWord(i, at)}`);
        // One tab stop for the whole chain: the current node. The arrow keys walk the rest.
        n.tabIndex = i === at ? 0 : -1;
      });
      dots.forEach((d, i) => {
        d.dataset.state = i < at ? 'done' : i === at ? 'active' : 'future';
      });
      if (stepEl) stepEl.textContent = String(at + 1);
      // aria-disabled, NOT the `disabled` property: a disabled element is not focusable, so reaching the
      // goal by pressing Enter on this very button destroyed the keyboard user's focus (verified: focus
      // fell to <body>, and the next Tab restarted from the top of the document). Keeping it focusable and
      // marking it disabled to AT preserves the focus position; the click/advance path is guarded instead.
      nextBtn!.setAttribute('aria-disabled', at >= last ? 'true' : 'false');
      root.dataset.done = at >= last ? 'true' : 'false';
      if (nextLabel) nextLabel.textContent = at >= last ? 'Compromised' : 'Next step';
    }

    // Connector k sits between node k and node k+1. The one that reached the current node is `current`,
    // the ones behind it `done`.
    function paintStrip(at: number): void {
      nodes.forEach((n, i) => {
        n.dataset.state = i < at ? 'done' : i === at ? 'active' : 'future';
      });
      conns.forEach((c, k) => {
        c.dataset.state = k + 1 < at ? 'done' : k + 1 === at ? 'current' : 'future';
      });
    }

    function announce(at: number): void {
      if (!status) return;
      const via = edges[at] ? `, via ${edges[at]}` : '';
      status.textContent = `Step ${at + 1} of ${last + 1}: ${labels[at]}${via}.${at >= last ? ' Compromised.' : ''}`;
    }

    // ── The dossier: its labels stand still and only the values change, rolling up as the chain climbs
    //    and down when it is walked back. ──
    function showPanel(from: number, to: number, dir: number): void {
      window.clearTimeout(panelTimer);
      panels.forEach((p, i) => {
        p.classList.remove('is-leaving', 'is-entering', 'is-down');
        p.removeAttribute('aria-hidden');
        p.hidden = i !== to;
      });
      if (reduced() || from === to || dir === 0) return;
      const old = panels[from];
      const cur = panels[to];
      old.hidden = false;
      old.setAttribute('aria-hidden', 'true');
      old.classList.add('is-leaving');
      cur.classList.add('is-entering');
      old.classList.toggle('is-down', dir < 0);
      cur.classList.toggle('is-down', dir < 0);
      panelTimer = window.setTimeout(() => {
        old.hidden = true;
        old.classList.remove('is-leaving', 'is-down');
        old.removeAttribute('aria-hidden');
        cur.classList.remove('is-entering', 'is-down');
      }, 420);
    }

    // ── Camera ──
    const maxScroll = (): number => Math.max(0, track!.scrollWidth - track!.clientWidth);
    const gutter = (): number => parseFloat(getComputedStyle(root).getPropertyValue('--ap-fade-w')) || 0;
    // Where the camera rests for step i. The current node is always whole; then as much of how it was reached
    // as fits, the hop first and the node before it second, so the frame reads from where you came from to
    // where you are, and the next node only peeks in. With nothing behind (the entry) it centres.
    function cameraLeft(i: number): number {
      const n = nodes[i];
      const w = track!.clientWidth;
      const g = gutter();
      // Further left than this, the current node's right edge would slide under the right-hand band.
      const floor = n.offsetLeft + n.offsetWidth - (w - g);
      let left = n.offsetLeft + n.offsetWidth / 2 - w / 2;
      if (i > 0) {
        for (const el of [conns[i - 1], nodes[i - 1]]) {
          const whole = el.offsetLeft - g;
          if (whole < left) left = Math.max(whole, floor);
        }
      }
      return Math.max(0, Math.min(maxScroll(), left));
    }

    // The past recedes: a node or connector that has slid mostly off the left edge fades out as a whole,
    // instead of leaving its border and check glyph behind without its name. Ahead, the next node keeps
    // peeking in under the right-hand fade, which is the "there is more path" cue.
    const recedable: HTMLElement[] = [...conns, ...nodes];
    function recede(): void {
      const left = track!.scrollLeft;
      recedable.forEach((el) => {
        const cut = left - el.offsetLeft;
        const o = cut <= 0 ? 1 : smoothstep(0.5, 0.9, 1 - cut / el.offsetWidth);
        if (o >= 0.999) el.style.removeProperty('opacity');
        else el.style.opacity = o.toFixed(3);
      });
    }

    // ── The spark ──
    // A point on connector k, `frac` of the way along its curve, in the spine's (= the scroll area's) pixels.
    function sparkPoint(k: number, frac: number): { x: number; y: number } {
      const c = conns[k];
      const pt = paths[k].getPointAtLength(lens[k] * frac);
      return { x: c.offsetLeft + pt.x, y: c.offsetTop + pt.y };
    }
    function sparkOff(fade: boolean): void {
      runner!.style.transition = fade ? 'opacity 0.1s ease' : 'none';
      runner!.style.opacity = '0';
    }
    // The connector under the spark draws behind it; null hands the stroke back to the stylesheet.
    function drawn(k: number, frac: number | null): void {
      const line = paths[k];
      if (frac === null) {
        line.style.removeProperty('stroke-dashoffset');
        line.style.removeProperty('transition');
        return;
      }
      line.style.transition = 'none';
      line.style.strokeDashoffset = String(dash - lens[k] * frac);
    }

    // One-time gold bloom on first arrival at the goal. Guarded, so clicking back and forward again never
    // replays it, and skipped entirely under reduced motion.
    function bloom(): void {
      if (bloomed || reduced()) return;
      bloomed = true;
      const goal = nodes[last];
      goal.classList.add('is-bloom');
      window.setTimeout(() => goal.classList.remove('is-bloom'), 1400);
    }

    // A step still playing finishes at once, so a new one always starts from rest.
    function stop(): void {
      if (!anim) return;
      const a = anim;
      anim = null;
      window.cancelAnimationFrame(a.raf);
      a.finish();
    }

    // Climbing, in two beats. First the spark leaves the node and runs the connector, drawing it as it goes,
    // and lands on the next node, which lights as it arrives; the camera holds still while the spark is on
    // screen and only follows it past the right-hand edge, so the spark never drifts backwards. Then the camera
    // settles on the new frame, carrying the lit node into place. A jump runs every hop in turn, faster.
    function climb(from: number, to: number): void {
      const hops = to - from;
      const per = Math.max(160, Math.min(380, 900 / hops));
      const travel = per * hops;
      const hold = 70;
      const settle = 360;
      const s0 = track!.scrollLeft;
      const s1 = cameraLeft(to);
      // The screen x the spark may not pass in flight: where it sets off, or the band's inner edge.
      const lead = Math.max(sparkPoint(from, 0).x - s0, track!.clientWidth - gutter() - 24);
      const swapAt = travel - Math.min(140, per * 0.35);
      let reached = from;
      let swapped = false;
      let arrived = false;
      let sArrive = s0;
      let end = travel + hold + settle;

      nodes[from].dataset.state = 'done';
      if (from > 0) conns[from - 1].dataset.state = 'done';
      for (let k = from; k < to; k++) drawn(k, 0);
      const p0 = sparkPoint(from, 0);
      runner!.style.transition = 'none';
      runner!.style.transform = `translate(${p0.x}px, ${p0.y}px)`;
      runner!.style.opacity = '1';

      const swap = (): void => {
        swapped = true;
        showPanel(from, to, 1);
      };
      const arrive = (): void => {
        arrived = true;
        sArrive = track!.scrollLeft;
        // Nothing left to settle: the step ends with the arrival.
        if (Math.abs(s1 - sArrive) < 1) end = travel;
        for (let k = from; k < to; k++) drawn(k, null);
        paintStrip(to);
        sparkOff(true);
      };
      const finish = (): void => {
        if (!swapped) {
          swapped = true;
          showPanel(from, to, 0);
        }
        if (!arrived) {
          arrived = true;
          for (let k = from; k < to; k++) drawn(k, null);
          paintStrip(to);
          sparkOff(false);
        }
        track!.scrollLeft = s1;
        recede();
      };
      const t0 = performance.now();
      const frame = (now: number): void => {
        const el = now - t0;
        if (!arrived) {
          const run = ease(clamp01(el / travel)) * hops;
          const h = Math.min(hops - 1, Math.floor(run));
          const frac = Math.min(1, run - h);
          for (let k = from; k < to; k++) drawn(k, k < from + h ? 1 : k === from + h ? frac : 0);
          while (reached < from + h) {
            reached += 1;
            nodes[reached].dataset.state = 'done';
            conns[reached - 1].dataset.state = 'done';
          }
          const pt = sparkPoint(from + h, frac);
          track!.scrollLeft = Math.max(s0, pt.x - lead);
          runner!.style.transform = `translate(${pt.x}px, ${pt.y}px)`;
          if (!swapped && el >= swapAt) swap();
          if (el >= travel) arrive();
        } else {
          const p = clamp01((el - travel - hold) / settle);
          track!.scrollLeft = sArrive + (s1 - sArrive) * ease(p);
        }
        recede();
        if (el < end) {
          anim = { raf: window.requestAnimationFrame(frame), finish };
          return;
        }
        anim = null;
        // The flourish waits for the frame to settle, so the goal blooms where it comes to rest.
        if (to === last) bloom();
      };
      anim = { raf: window.requestAnimationFrame(frame), finish };
    }

    // Walking back: no spark. The strip returns to that step (the lines retract on their own transition)
    // and the camera pans back on the same curve.
    function descend(from: number, to: number): void {
      sparkOff(false);
      paintStrip(to);
      showPanel(from, to, -1);
      const s0 = track!.scrollLeft;
      const s1 = cameraLeft(to);
      const dur = 420;
      const t0 = performance.now();
      const finish = (): void => {
        track!.scrollLeft = s1;
        recede();
      };
      const frame = (now: number): void => {
        const p = clamp01((now - t0) / dur);
        track!.scrollLeft = s0 + (s1 - s0) * ease(p);
        recede();
        if (p < 1) anim = { raf: window.requestAnimationFrame(frame), finish };
        else anim = null;
      };
      anim = { raf: window.requestAnimationFrame(frame), finish };
    }

    function go(to: number, focusNode: boolean): void {
      const target = Math.max(0, Math.min(last, to));
      if (target === pos) return;
      stop();
      const from = pos;
      pos = target;
      paintChrome(target);
      announce(target);
      if (focusNode) nodes[target].focus({ preventScroll: true });
      if (reduced()) {
        sparkOff(false);
        paintStrip(target);
        showPanel(from, target, 0);
        track!.scrollLeft = cameraLeft(target);
        recede();
        return;
      }
      if (target > from) climb(from, target);
      else descend(from, target);
    }

    // Guarded rather than relying on the `disabled` property, which would take the button out of the tab
    // order at exactly the moment the user pressed it. `go()` clamps anyway; this keeps the intent explicit.
    nextBtn.addEventListener('click', () => {
      if (pos >= last) return;
      go(pos + 1, false);
    });
    nodes.forEach((n, i) => n.addEventListener('click', () => go(i, false)));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i, false)));

    // Arrow keys are scoped to the component, so they only act while focus is inside it and never hijack
    // the page's own scrolling. On a node they carry focus along with the step, so the focused node is
    // always the current one and always on screen; Home and End jump to the ends of the chain.
    root.addEventListener('keydown', (ev: KeyboardEvent) => {
      const onNode = nodes.includes(ev.target as HTMLButtonElement);
      let to = -1;
      if (ev.key === 'ArrowRight') to = pos + 1;
      else if (ev.key === 'ArrowLeft') to = pos - 1;
      else if (onNode && ev.key === 'Home') to = 0;
      else if (onNode && ev.key === 'End') to = last;
      else return;
      ev.preventDefault();
      go(to, onNode);
    });

    // A swipe moves the camera by hand; the past still recedes as it goes.
    let pending = 0;
    track.addEventListener('scroll', () => {
      if (pending || anim) return;
      pending = window.requestAnimationFrame(() => {
        pending = 0;
        recede();
      });
    }, { passive: true });
    // When the strip's width or its fonts change, the current node is re-centred and the edges re-read.
    let settle = 0;
    new ResizeObserver(() => {
      window.cancelAnimationFrame(settle);
      settle = window.requestAnimationFrame(() => {
        if (anim) return;
        track!.scrollLeft = cameraLeft(pos);
        recede();
      });
    }).observe(track);

    paintChrome(pos);
    paintStrip(pos);
    recede();
  }

  function initAttackPaths(): void {
    document.querySelectorAll('[data-attack-path]').forEach((el) => setupAttackPath(el as HTMLElement));
  }
  initAttackPaths();
  // Idempotent, so it also holds if the site ever adopts Astro's client router, which fires this after each
  // navigation.
  document.addEventListener('astro:page-load', initAttackPaths);
</script>

<style>
  /* Every surface, border, and accent here is the site's own fabric, so this reads as a rich region of
     the writeup, not a widget dropped onto it. The aliases each map to an EXISTING token or the exact
     derivation the site's own components use:
       --ap-accent  the site's content accent. --pf-accent only exists on a .pf-* ancestor, so the
                    fallback (--sl-color-text-accent, the theme-aware lime) is what actually resolves in a
                    writeup body; the fallback idiom is PlatformIndex's. It is already AA as text in both
                    themes (light is the deep #4d7c0f ink), so no separate ink token is needed for it.
       --ap-gold /  the site's prize identity, split exactly like FlagCapture's --fc-id / --fc-val:
       --ap-gold-ink  --flag-gold paints DECORATION (borders, glow, runner, bloom), --flag-gold-val is the
                    AA-grade gold for any gold TEXT (the decorative gold is only 2.00:1 on paper).
       --ap-line    the site's structural hairline (--tp-divider on light via the global override).
       --ap-quiet   the muted label grey the site uses for eyebrows/meta.
       --ap-surface the site's raised-panel FABRIC, taken straight from the Toggle / FlagCapture panel:
                    a 2% white lift over the page on dark, the warm paper panel #f2ede0 on light. It is a
                    solid colour (the dark value is the opaque equivalent of the Toggle's
                    rgba(255,255,255,0.02) lift) so the edge fade-masks can dissolve INTO it cleanly. The
                    #f2ede0 literal is the site's established panel value (Toggle + FlagCapture both use
                    it, and there is no token for it), so matching it is reusing the convention. */
  .apath {
    --ap-accent: var(--pf-accent, var(--sl-color-text-accent));
    --ap-gold: var(--flag-gold);
    --ap-gold-ink: var(--flag-gold-val);
    --ap-line: var(--sl-color-hairline);
    --ap-quiet: var(--sl-color-gray-3);
    --ap-surface: color-mix(in oklab, var(--sl-color-white) 2%, var(--sl-color-bg));
    /* ONE value drives BOTH the edge mask's band width and the spine's resting gutter (below), which is
       what keeps the mask off the endpoint nodes: the gutter is exactly as wide as the band, so at either
       scroll extreme the mask lands on empty gutter instead of on the start / goal node. It also makes the
       affordance self-truthing: a mask over empty gutter is surface-on-surface, i.e. INVISIBLE, so a fade
       only appears once real path is actually running under it. */
    --ap-fade-w: 36px;

    position: relative;
    margin: 1.75rem 0 2.25rem;
    padding: 1.1rem 1.1rem 0.9rem;
    border: 1px solid var(--ap-line);
    border-radius: 8px;               /* the site's card radius (Toggle/FlagCapture are 6px, cards 8px) */
    background: var(--ap-surface);
  }
  :global(html[data-theme='light']) .apath {
    --ap-surface: #f2ede0;
    /* The same warm depth shadow the Toggle and FlagCapture panels use, so it lifts off the paper the
       same way (V3 light surface depth), instead of glaring as a flat near-white block. */
    box-shadow: 0 4px 14px -12px rgba(60, 50, 30, 0.4);
  }

  /* ── Header ── */
  .ap-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.9rem;
  }
  .ap-title {
    margin: 0;
    font-family: var(--tp-display); /* Syne: display face, loaded at 600/700/800 only */
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.01em;
    color: var(--sl-color-white);
  }
  .ap-meter {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .ap-meter-text {
    margin: 0;
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ap-quiet);
    white-space: nowrap;
  }
  .ap-meter-text span {
    color: var(--ap-accent);
    font-weight: 700;
  }
  /* Light only, the accent-high carve-out once more: on paper the ambient accent reads 4.27:1 as this 11.2px
     bold count (#4d7c0f on the #f2ede0 panel), under AA; bold only counts as large text from 18.66px. */
  :global(html[data-theme='light']) .apath:not([data-done='true']) .ap-meter-text span { color: var(--sl-color-accent-high); }
  /* At the goal the count turns gold with the rest of the end state: the Compromised control, the goal's
     dossier panel and the last dot. A green count beside them was the odd one out. */
  .apath[data-done='true'] .ap-meter-text span { color: var(--ap-gold-ink); }
  /* ── Stage: the masked window onto the scrolling track ── */
  .ap-stage { position: relative; }
  .ap-track {
    overflow-x: auto;
    overflow-y: visible;
    scrollbar-width: none;              /* Firefox */
    -ms-overflow-style: none;
    /* Keep a horizontal swipe inside the path. Without this, flicking past either end of the track chains
       the scroll to the page and, on touch, can trigger the browser's back-navigation gesture, so a reader
       swiping the chain could be thrown off the writeup entirely. */
    overscroll-behavior-x: contain;
  }
  .ap-track::-webkit-scrollbar { display: none; }

  .ap-spine {
    position: relative;
    display: flex;
    align-items: center;                /* every item shares one centre line, so `bottom` alone makes the ascent */
    width: max-content;
    /* Headroom for the FULL climb plus the active node's scale and glow. This reads the total climb, not
       the per-hop rise: rise shrinks as the chain lengthens (it is climb/hops), so sizing off rise would
       under-pad and clip the top node on any chain longer than five hops.
       The INLINE padding is the mask gutter: it matches --ap-fade-w exactly, so scrolled fully left the
       start node rests precisely where the left band ends, and scrolled fully right the goal node rests
       precisely where the right band ends. The two most important anchors in the chain therefore always
       come to rest in the fully-legible zone (measured alpha 0), at any chain length, while mid-scroll the
       mask still dissolves real content and the affordance is untouched. */
    padding: calc(var(--ap-climb) + 26px) var(--ap-fade-w) 30px;
  }

  .ap-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--ap-fade-w);
    pointer-events: none;
    z-index: 2;
  }
  /* The masks dissolve the track edges INTO the container's own surface (--ap-surface flips per theme),
     so "there is more path" reads as the content running under the panel edge, not fading to black.
     The falloff is a SMOOTHSTEP (1 - (3t^2 - 2t^3)), not the previous `surface 14%, transparent` linear
     ramp. Two things were wrong with that ramp: it held a fully OPAQUE plateau across its first 14% and
     then smeared linearly, so a node's text could begin under ~78% wash (measured on the start node). The
     eased curve drops the plateau, so the band is only truly opaque at the outermost edge, recovers most
     of its legibility by mid-band, and has no hard cut-off at either end. Paired with the gutter above it
     means the mask is gentler everywhere AND never falls on an endpoint at rest. */
  .ap-fade-l {
    left: 0;
    background: linear-gradient(90deg,
      var(--ap-surface) 0%,
      color-mix(in oklab, var(--ap-surface) 84%, transparent) 25%,
      color-mix(in oklab, var(--ap-surface) 50%, transparent) 50%,
      color-mix(in oklab, var(--ap-surface) 16%, transparent) 75%,
      transparent 100%);
  }
  .ap-fade-r {
    right: 0;
    background: linear-gradient(270deg,
      var(--ap-surface) 0%,
      color-mix(in oklab, var(--ap-surface) 84%, transparent) 25%,
      color-mix(in oklab, var(--ap-surface) 50%, transparent) 50%,
      color-mix(in oklab, var(--ap-surface) 16%, transparent) 75%,
      transparent 100%);
  }

  /* ── Node ── */
  .ap-node {
    position: relative;
    bottom: calc(var(--ap-rise) * var(--i));   /* the ascent: each node sits one rise above the last */
    flex: none;
    /* Escalation: --t runs 0 to 1 across the chain, so width and type scale grow toward the goal
       regardless of how many hops the chain has. */
    width: calc(148px + var(--t) * 56px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.24rem;
    padding: 0.62rem 0.72rem;
    text-align: left;
    border: 1px solid var(--ap-line);
    border-radius: 8px;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    cursor: pointer;
    --focus-ring: var(--ap-accent);
  }
  .ap-node-kind {
    font-family: var(--sl-font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ap-quiet);
    /* Reserve the gutter the absolutely-positioned check glyph occupies (right: 0.5rem + its 13px box,
       less the node's own inline padding) so an unusually long kind wraps instead of running underneath it.
       Real kinds are one short word, so this never bites in practice; it is a guard, not a layout device. */
    max-width: calc(100% - 0.7rem);
  }
  .ap-node-name {
    font-family: var(--sl-font-mono);
    font-size: calc(0.875rem + var(--t) * 0.125rem);
    /* Escalation weight uses ONLY the loaded JetBrains Mono faces (400/500/700). A continuous
       calc(500 + --t*200) requested 540/580/620/660, none of which exist, so the browser snapped every
       one to Bold 700 (measured: identical ink to 700) and the "ramp" was really a step at node 0. The
       honest crescendo therefore rides the continuous font-SIZE above, plus one derived weight step:
       Medium before the chain's midpoint, Bold from it on (--ap-nw, computed from the node's --t). */
    font-weight: var(--ap-nw, 500);
    line-height: 1.28;
    color: var(--sl-color-white);
    overflow-wrap: anywhere;
    text-wrap: balance;               /* a two-line name splits evenly instead of leaving one word behind */
  }
  .ap-check {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    opacity: 0;
    color: var(--ap-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* No opacity here: the script fades the receding past frame by frame with the camera. */
    .ap-node { transition: transform 0.34s cubic-bezier(0.4, 0.05, 0.2, 1), border-color 0.3s ease, box-shadow 0.34s ease, background-color 0.3s ease; }
    .ap-check { transition: opacity 0.3s ease 0.12s; }
  }

  /* future: quiet and slightly smaller, clearly not yet reached.
     The quiet is carried by COLOUR and scale, never by group `opacity`. An earlier `opacity: 0.4` faded the
     text and the chrome together, which pushed real content under AA: measured 3.83:1 (dark) / 2.43:1
     (light) on the node name and 1.88 / 1.79 on the kind, against the 4.5:1 this text needs. These are not
     inactive controls, a future node is clickable to jump ahead, so WCAG's inactive-component exemption
     does not apply. Opacity is a blunt instrument here: to lift the kind label to AA it would have had to
     run at ~0.88, which erases the state entirely. Per-element colours keep the hierarchy AND the ratio:
     the name drops to the muted grey (5.78:1) while done/active names stay full-contrast white (16.8 /
     16.0), and the goal keeps its gold ink through the later .is-goal rule (5.24:1). */
  .ap-node[data-state='future'] {
    transform: scale(0.955);
  }
  .ap-node[data-state='future'] .ap-node-name { color: var(--ap-quiet); }
  /* active: the focal point. Accent-bordered, softly glowing, and STATIC once it settles.
     The lift is carried by scale + the elevation shadow, deliberately NOT by translateY: scale keeps an
     element's CENTRE fixed while translateY moves it off the rise ladder, and the connectors aim at node
     centres. A 5px translate here measurably dropped the incoming arrowhead 5px below the node it points
     at (rise 13.4px instead of 18.4px on the active hop), which breaks the one thing the connectors have
     to get right. Geometry wins over the extra 5px of lift. */
  /* active + done both carry a faint ACCENT fill derived the way the callouts and the FlagCapture hover
     derive theirs (color-mix of the accent into the panel surface), so the tint intensity is the crescendo
     active (12%) > done (7%) > future (none). The two are then told apart by non-tint cues as well: active
     scales up, takes the full accent border + the FlagCapture-style glow, and reads its kind label in
     accent; done settles to a softer border, no glow, and carries the check glyph (so state is never colour
     alone). */
  .ap-node[data-state='active'] {
    opacity: 1;
    transform: scale(1.045);
    border-color: var(--ap-accent);
    background: color-mix(in oklab, var(--ap-accent) 12%, var(--ap-surface));
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--ap-accent) 34%, transparent),
      0 8px 26px -12px color-mix(in oklab, var(--ap-accent) 60%, transparent);
  }
  .ap-node[data-state='active'] .ap-node-kind { color: var(--ap-accent); }
  /* Same carve-out the primary "Next step" control already needed, for the same reason: on paper the
     ambient accent sitting ON its own 12% accent tint measures only 3.94:1 as an 11px label, under AA.
     The site's text-legible accent variant clears it at 7.59:1. Light only, dark accent is already 13.3:1.
     The :not(.is-goal) is load-bearing: adding html[data-theme] to the selector out-specifies the later
     .is-goal[data-state='active'] gold rule, which silently turned the GOAL's kind label green (verified:
     it computed accent-high instead of the gold ink). The goal keeps its prize identity in every state. */
  :global(html[data-theme='light']) .ap-node[data-state='active']:not(.is-goal) .ap-node-kind { color: var(--sl-color-accent-high); }
  /* done: established and illuminated, but calm enough not to compete with the active node */
  .ap-node[data-state='done'] {
    opacity: 1;
    border-color: color-mix(in oklab, var(--ap-accent) 48%, var(--ap-line));
    background: color-mix(in oklab, var(--ap-accent) 7%, var(--ap-surface));
  }
  .ap-node[data-state='done'] .ap-check { opacity: 1; }
  .ap-node[data-state='done'] .ap-node-name { color: color-mix(in oklab, var(--ap-accent) 26%, var(--sl-color-white)); }

  /* The goal wears the site's PRIZE identity (gold) in every state, derived exactly as FlagCapture derives
     its frame: a flat gold tint over the panel surface (no gradient), a gold-mix border, and the AA text
     gold for the label. Future = a quiet gold preview so the destination is legible from the start; reached
     = the full gold frame + glow, the same treatment a captured flag gets. */
  .ap-node.is-goal {
    --focus-ring: var(--ap-gold-ink);
    border-color: color-mix(in oklab, var(--ap-gold) 38%, var(--ap-line));
    background: color-mix(in oklab, var(--ap-gold) 6%, var(--ap-surface));
  }
  .ap-node.is-goal .ap-node-name { color: var(--ap-gold-ink); font-weight: 700; }
  .ap-node.is-goal .ap-check { color: var(--ap-gold-ink); }
  .ap-node.is-goal[data-state='active'],
  .ap-node.is-goal[data-state='done'] {
    border-color: var(--ap-gold);
    background: color-mix(in oklab, var(--ap-gold) 12%, var(--ap-surface));
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--ap-gold) 42%, transparent),
      0 10px 30px -12px color-mix(in oklab, var(--ap-gold) 66%, transparent);
  }
  .ap-node.is-goal[data-state='active'] .ap-node-kind,
  .ap-node.is-goal[data-state='done'] .ap-node-kind { color: var(--ap-gold-ink); }
  /* The entry point gets a quiet accent tick so the chain has a visible beginning as well as an end. */
  .ap-node.is-start { border-left: 2px solid color-mix(in oklab, var(--ap-accent) 55%, var(--ap-line)); }
  /* A node is a control, so it answers the pointer: the border warms toward the accent (gold on the goal). */
  @media (hover: hover) {
    .apath[data-enhanced] .ap-node:not([data-state='active']):hover { border-color: color-mix(in oklab, var(--ap-accent) 70%, var(--ap-line)); }
    .apath[data-enhanced] .ap-node.is-goal:not([data-state='active']):hover { border-color: var(--ap-gold); }
  }

  /* ── Connector ── */
  .ap-conn {
    position: relative;
    bottom: calc(var(--ap-rise) * var(--i));  /* aligned to the LEFT node, so the curve ends on the right node's centre */
    flex: none;
    width: var(--ap-cw);
    height: var(--ap-ch);
    margin: 0 -3px;   /* see the tip-overshoot note in the frontmatter */
  }
  .ap-conn-svg { display: block; overflow: visible; }
  .ap-conn-base {
    fill: none;
    stroke: var(--ap-quiet);
    stroke-width: 1.5;
    stroke-dasharray: 3 5;
    opacity: 0.45;
  }
  .ap-conn-live,
  .ap-conn-head {
    fill: none;
    stroke: var(--ap-accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Hidden until the hop is taken: the dash pattern is longer than the path, so a full offset hides
     the whole stroke and offset 0 reveals it end to end. */
  .ap-conn-live {
    stroke-dasharray: var(--ap-dash);
    stroke-dashoffset: var(--ap-dash);
  }
  .ap-conn-head { opacity: 0; }
  .ap-conn:is([data-state='done'], [data-state='current']) .ap-conn-live { stroke-dashoffset: 0; }
  .ap-conn:is([data-state='done'], [data-state='current']) .ap-conn-head { opacity: 1; }
  .ap-conn:is([data-state='done'], [data-state='current']) .ap-conn-base { opacity: 0; }
  /* The last hop lands in gold, matching the goal it arrives at. */
  .ap-conn.is-goal-conn .ap-conn-live,
  .ap-conn.is-goal-conn .ap-conn-head { stroke: var(--ap-gold); }

  @media (prefers-reduced-motion: no-preference) {
    /* Forward, the script draws the line with the spark; this transition only retracts it on the way back. */
    .ap-conn-live { transition: stroke-dashoffset 0.4s cubic-bezier(0.4, 0.05, 0.2, 1); }
    .ap-conn-head { transition: opacity 0.18s ease; }
    .ap-conn-base { transition: opacity 0.3s ease; }
  }

  /* The technique rides ON the segment, parallel to it. Anchor: the label's BOTTOM edge sits a
     constant gap above the connector's mid-line (translateY(-100%) lands the bottom edge on the anchor
     no matter how many lines the label wraps to, so one- and two-line labels keep the same distance to
     the line); then a rotation about that bottom-centre point tilts the label to the chord's angle, which
     makes the gap independent of the slope and of the label's width. This is the single rule that holds
     for any segment and any label, replacing the old horizontal translate(-50%,-160%) whose clearance
     swung from +17px to crossing the line across one label. */
  .ap-edge {
    position: absolute;
    left: 50%;
    top: calc(50% - var(--ap-rise) / 2 - 0.4rem);
    transform-origin: 50% 100%;
    transform: translate(-50%, -100%) rotate(var(--ap-edge-angle, 0deg));
    width: calc(var(--ap-cw) - 6px);
    text-align: center;
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    line-height: 1.35;
    letter-spacing: 0.02em;
    color: var(--ap-quiet);
    pointer-events: none;
  }
  /* One technique is lit at a time: the hop that reached the current node. The way ahead and the hops
     behind stay quiet (AA grey, bold kept), so the eye lands on how this step was won, not on the next. */
  .ap-edge :global(b) { font-weight: 700; color: var(--ap-quiet); }
  .ap-conn[data-state='current'] .ap-edge { color: color-mix(in oklab, var(--ap-accent) 62%, var(--sl-color-text)); }
  .ap-conn[data-state='current'] .ap-edge :global(b) { color: var(--ap-accent); }
  /* Light only: on the #f2ede0 panel the accent reads 4.27:1 as this 11.5px bold run (model C
     median), under AA. The lime ink reads 5.71:1 there (model C median) and stays lighter than the
     caption's own text (OKLCH L 0.47 against 0.41); accent-high (L 0.38) would sink the run into it.
     The goal's run keeps its gold ink. */
  :global(html[data-theme='light']) .ap-conn[data-state='current']:not(.is-goal-conn) .ap-edge :global(b) { color: var(--tp-lime-ink); }
  .ap-conn.is-goal-conn[data-state='current'] .ap-edge :global(b) { color: var(--ap-gold-ink); }

  /* ── Runner: the gold spark that runs each connector, from the node it leaves to the node it reaches.
     The script places it on the curve every frame, in the spine's own coordinates, while it scrolls the
     track on the same clock, so the two can no longer pull against each other. ── */
  .ap-runner {
    position: absolute;
    top: 0;
    left: 0;
    width: 9px;
    height: 9px;
    margin: -4.5px 0 0 -4.5px;
    border-radius: 50%;
    background: var(--ap-gold);
    box-shadow: 0 0 12px 2px color-mix(in oklab, var(--ap-gold) 70%, transparent);
    opacity: 0;
    pointer-events: none;
    z-index: 3;
  }

  /* ── Goal flourish: one bloom + one ripple, never looping ── */
  .ap-node.is-bloom::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: inherit;
    border: 2px solid var(--ap-gold);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ap-node.is-bloom { animation: ap-bloom 1.1s ease-out 1; }
    .ap-node.is-bloom::after { animation: ap-ripple 1.1s cubic-bezier(0.2, 0.6, 0.3, 1) 1 forwards; }
  }
  @keyframes ap-bloom {
    0%   { box-shadow: 0 0 0 1px color-mix(in oklab, var(--ap-gold) 42%, transparent), 0 10px 30px -12px color-mix(in oklab, var(--ap-gold) 66%, transparent); }
    38%  { box-shadow: 0 0 0 2px var(--ap-gold), 0 0 42px 6px color-mix(in oklab, var(--ap-gold) 78%, transparent); }
    100% { box-shadow: 0 0 0 1px color-mix(in oklab, var(--ap-gold) 42%, transparent), 0 10px 30px -12px color-mix(in oklab, var(--ap-gold) 66%, transparent); }
  }
  /* The ring spreads as a shadow, not a scale: a shadow is painted overflow, so it never adds scroll width,
     and at 12px it stays inside the gutter the goal rests in. */
  @keyframes ap-ripple {
    0%   { opacity: 0.85; box-shadow: 0 0 0 0 color-mix(in oklab, var(--ap-gold) 70%, transparent); }
    100% { opacity: 0; box-shadow: 0 0 0 12px color-mix(in oklab, var(--ap-gold) 0%, transparent); }
  }

  /* ── Dossier ── */
  /* Every panel is laid out at once, stacked in ONE cell, and only the current one is visible, so the cell
     is as tall as the tallest panel at every step and the footer below it (the dots and the Next button)
     never moves. While each panel took its own height the footer moved between steps, up to 27px at desktop
     and 44px on a 375px phone, so a second click on Next could land where the button had been. The stack also lets the panels share one label column: each panel is a
     SUBGRID of these two columns, so the label column is as wide as the widest label in the whole chain
     and the seam between labels and values holds the same x at every step. */
  .ap-dossier {
    --ap-col-gap: 0.85rem;             /* the label-to-value gutter, read here AND by each panel (below) */
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--ap-col-gap);
    margin-top: 0.5rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--ap-line);
    min-height: 92px;
  }
  /* ONE grid holds every row of a panel: the kind and name, the edge the node was reached by, and the
     detail rows. It used to be three layout systems, a flex head, an inline "via" line and a grid, and each
     started its values at its own x, so one panel showed its values at up to three x positions, 12 to 27px
     apart (measured on every writeup that carries one). The rows are told apart only by how they look: the head by its
     coloured kind label and the large bold name, the edge by its quiet ink with the technique in bold, the
     details by body text. Hierarchy is colour, weight and size, never position.
     align-items: baseline sets every label on its value's first baseline. That replaced a padding-top nudge
     on the labels, which was a declared relationship and measured 0.65px off. */
  .ap-panel {
    --ap-row-gap: 0.24rem;
    grid-area: 1 / 1 / 2 / -1;          /* every panel in the same cell */
    align-self: start;                 /* a shorter panel keeps its rows packed at the top of the cell */
    margin: 0;
    display: grid;                     /* author origin, so it outranks the UA's [hidden] { display: none } */
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    row-gap: var(--ap-row-gap);
    column-gap: var(--ap-col-gap);     /* a subgrid inherits the dossier's gap, a fallback grid does not */
    font-family: var(--sl-font-mono);
    font-size: 0.875rem;
  }
  /* Where subgrid exists (Chrome 117, Safari 16, Firefox 71) the panels share the dossier's two columns.
     The build's browser floor reaches back to Chrome 111, which lacks it; there each panel keeps the two
     columns above, so its rows still line up and nothing moves vertically, and only the seam can shift
     between steps. @supports rather than a second declaration, so a minifier cannot fold the fallback away. */
  @supports (grid-template-columns: subgrid) {
    .ap-panel { grid-template-columns: subgrid; }
  }
  /* An inactive panel keeps its box, so it still sizes the cell and the label column, but it is never
     painted, never announced (visibility: hidden takes it out of the accessibility tree, as display: none
     did) and never copied (user-select: none keeps it out of a Ctrl+A selection, the rule this site applies
     to text that is hidden without being removed). The hidden attribute stays in the markup, so without
     this stylesheet the panels fall back to the browser's own display: none. */
  .ap-panel[hidden] {
    visibility: hidden;
    user-select: none;
    -webkit-user-select: none;
  }
  /* One label voice for the whole column, the tracking the node's own kind label uses. Labels align to the
     SEAM, not to the panel's edge, so every label sits one gutter from its own value however long the
     others are: left-aligned, a short label such as "via" stood the whole width of the widest label
     ("action", "account") away from its value. */
  .ap-panel dt {
    text-align: right;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.6875rem;
    color: var(--ap-quiet);
  }
  .ap-panel dd {
    margin: 0;
    line-height: 1.5;                  /* a value that wraps on a phone reads as one block, not two rows */
    color: var(--sl-color-text);
    overflow-wrap: anywhere;
  }
  /* The head row mirrors its node: the kind label in the node's colour and the name at the dossier's
     largest size, and on the goal both in gold, as on the goal node itself. */
  .ap-panel .ap-panel-kind {
    font-weight: 500;
    color: var(--ap-accent);
  }
  /* Light only, the carve-out the active node's kind label and the Next button already carry, for the same
     reason: on paper the ambient accent reads 4.27:1 as this 11px label (#4d7c0f on the #f2ede0 panel,
     which is opaque, so that pair is the composite), under AA. The text-legible accent variant clears it.
     The dark accent is already 16.1:1 on the dark panel. :not(.is-goal) so the theme prefix cannot
     out-specify the goal's gold below, the trap the node's own kind label already documents. */
  :global(html[data-theme='light']) .ap-panel:not(.is-goal) .ap-panel-kind { color: var(--sl-color-accent-high); }
  .ap-panel .ap-panel-name {
    font-size: 1rem;
    line-height: 1.3;
    font-weight: 700;
    color: var(--sl-color-white);
  }
  .ap-panel.is-goal .ap-panel-kind,
  .ap-panel.is-goal .ap-panel-name { color: var(--ap-gold-ink); }
  /* The edge row reads a step quieter than the details; the technique itself is carried by the bold. */
  .ap-panel .ap-panel-edge { color: var(--ap-quiet); }
  .ap-panel .ap-panel-edge :global(b) { color: var(--sl-color-text); font-weight: 700; }
  /* The head and the edge each stand a little clear of the row below (0.4rem and 0.5rem, their spacing
     from before they joined the grid). Written as the extra over the row gap, so the totals hold if the
     gap is ever retuned. Both cells of the row carry it, so whichever is taller still sets the space. */
  .ap-panel .ap-panel-kind,
  .ap-panel .ap-panel-name { margin-bottom: calc(0.4rem - var(--ap-row-gap)); }
  .ap-panel .ap-panel-via,
  .ap-panel .ap-panel-edge { margin-bottom: calc(0.5rem - var(--ap-row-gap)); }
  /* Inline <code> inside a dossier row: this subtree styles its own.
     The mechanism is LAYER ORDER, not `not-content`. The site's inline-code chip is authored as a bare
     `:not(pre) > code` in the prose layer with no .not-content guard, so it does reach in here; what
     keeps this rule on top is that an Astro scoped style is UNLAYERED, and unlayered author CSS beats
     any layered rule regardless of selector weight. The `not-content` class governs REACH for the
     rules that do carry the guard, which is a separate instrument from precedence.
     The ink leans toward --sl-color-white on purpose: that token is the page's FOREGROUND in either theme,
     so the mix brightens the chip text on dark and deepens it on paper. */
  .ap-panel dd :global(code) {
    font-family: var(--sl-font-mono);
    font-size: 0.92em;
    padding: 0.06em 0.34em;
    border-radius: 4px;
    background: color-mix(in oklab, var(--ap-accent) 12%, transparent);
    color: color-mix(in oklab, var(--ap-accent) 78%, var(--sl-color-white));
  }
  /* The goal's chips wear its gold, derived the same way: the decorative gold for the tint, the AA gold
     ink for the text. Every other panel keeps the accent chips. */
  .ap-panel.is-goal dd :global(code) {
    background: color-mix(in oklab, var(--ap-gold) 12%, transparent);
    color: color-mix(in oklab, var(--ap-gold-ink) 78%, var(--sl-color-white));
  }

  /* A step changes the answers, not the form: the labels swap in place (most panels share them, so they
     read as standing still), and only the values roll, up as the chain climbs and down when it is walked
     back. The old values are gone before the new ones settle, so the two never sit on top of each other. */
  .ap-panel.is-leaving { visibility: visible; }
  .ap-panel.is-leaving dt { visibility: hidden; }
  @media (prefers-reduced-motion: no-preference) {
    .ap-panel.is-leaving dd { animation: ap-val-out 0.13s ease-in 1 forwards; }
    .ap-panel.is-entering dd { animation: ap-val-in 0.26s cubic-bezier(0.4, 0.05, 0.2, 1) 0.09s 1 backwards; }
    .ap-panel.is-leaving.is-down dd { animation-name: ap-val-out-down; }
    .ap-panel.is-entering.is-down dd { animation-name: ap-val-in-down; }
  }
  @keyframes ap-val-out { to { opacity: 0; transform: translateY(-4px); } }
  @keyframes ap-val-out-down { to { opacity: 0; transform: translateY(4px); } }
  @keyframes ap-val-in { from { opacity: 0; transform: translateY(5px); } }
  @keyframes ap-val-in-down { from { opacity: 0; transform: translateY(-5px); } }

  /* ── Footer ── */
  .ap-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.95rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--ap-line);
  }
  .ap-dots { display: flex; flex-wrap: wrap; align-items: center; gap: 0 10px; }
  .ap-dot {
    /* This dot's colour on the chain's green-to-gold ramp, the one the meter bar draws: the same two
       colours, mixed by the dot's position (--t, 0 at the entry and 1 at the goal) in sRGB, the space a
       gradient interpolates in by default, so a reached dot and the bar's leading edge at that step are
       one colour. Derived from --t, so the first dot is the accent and the last is gold at any chain
       length. The focus ring rides the same ramp toward the gold INK instead, because a ring needs 3:1
       and the decorative gold is 2.00:1 on paper; the last dot's ring is the goal node's. */
    --ap-dot-c: color-mix(in srgb, var(--ap-accent), var(--ap-gold) calc(var(--t, 0) * 100%));
    --focus-ring: color-mix(in srgb, var(--ap-accent), var(--ap-gold-ink) calc(var(--t, 0) * 100%));
    position: relative;
    display: grid;
    place-items: center;
    width: 14px;                       /* with the row's gap, each dot owns a 24px square of the row */
    height: 24px;
    cursor: pointer;
  }
  /* The visible dot is drawn inside the target, so tools measure the target and readers see the dot. */
  .ap-dot::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: color-mix(in oklab, var(--ap-quiet) 45%, transparent);
  }
  /* A future dot stays the quiet grey, as the bar's unfilled track does; a reached dot takes its own place
     on the ramp, softer once passed and full on the current step. */
  .ap-dot[data-state='done']::before { background: color-mix(in oklab, var(--ap-dot-c) 60%, transparent); }
  .ap-dot[data-state='active']::before {
    background: var(--ap-dot-c);
    transform: scale(1.5);
  }
  @media (hover: hover) {
    .ap-dot:not([data-state='active']):hover::before { background: color-mix(in oklab, var(--ap-dot-c) 80%, transparent); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .ap-dot::before { transition: background-color 0.25s ease, transform 0.25s ease; }
  }
  /* Shown only while a node holds keyboard focus, where the arrow keys are what moves the climb on. It sits
     in the stage's bottom padding, so it never moves anything. The nodes point at it with aria-describedby,
     so a screen reader hears it too. */
  .ap-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.3rem;
    z-index: 3;
    margin: 0;
    font-family: var(--sl-font-mono);
    font-size: 0.6875rem;
    text-align: center;
    color: var(--ap-quiet);
    pointer-events: none;
    visibility: hidden;
  }
  .apath:has(.ap-node:focus-visible) .ap-hint { visibility: visible; }

  /* The advance control follows the site's own accent-button pattern (PasswordReveal's .pw-action):
     a TRANSPARENT rest fill with a coloured border and label, filling only on hover. That is not just
     stylistic parity: putting accent text on an accent tint drops the small bold label to 3.79:1 on
     paper (below AA), whereas the accent ink on the plain panel is the AA-safe pairing the site relies
     on everywhere. So the transparent rest fill is what keeps the label legible in light. */
  .ap-next {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.42rem 0.85rem;
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ap-accent);
    background: transparent;
    border: 1px solid color-mix(in oklab, var(--ap-accent) 45%, transparent);
    border-radius: 6px;
    cursor: pointer;
    --focus-ring: var(--ap-accent);
  }
  /* On paper the ambient accent (#4d7c0f) sits at ~4.3:1 as small bold text, just under AA. The site's
     own text-legible accent variant, --sl-color-accent-high (#2f4d09 light), clears it, and using it for
     the PRIMARY control is right anyway: the CTA should read a step above the ambient accent. Light only,
     because the dark accent is already ~13:1. */
  :global(html[data-theme='light']) .ap-next { color: var(--sl-color-accent-high); }
  /* Keyed off aria-disabled, since the control stays a real focusable button at the end of the chain
     (see the focus note in the script) rather than taking the `disabled` property. */
  .ap-next:not([aria-disabled='true']):hover {
    background: color-mix(in oklab, var(--ap-accent) 12%, transparent);
    border-color: var(--ap-accent);
  }
  /* At the end the control stops being an instruction and becomes a state, and now it looks like one: gold
     ink and a check, no frame to suggest there is anything left to press. Same box, so nothing moves, and it
     keeps focus (see the script). */
  .ap-done-ico { display: none; }
  .apath[data-done='true'] .ap-next {
    color: var(--ap-gold-ink);
    background: transparent;
    border-color: transparent;
    cursor: default;
  }
  .apath[data-done='true'] .ap-next-ico { display: none; }
  .apath[data-done='true'] .ap-done-ico { display: block; }
  @media (prefers-reduced-motion: no-preference) {
    .ap-next { transition: background-color 0.22s ease, border-color 0.22s ease, color 0.22s ease; }
  }

  /* Windows High Contrast flattens tints and glows, so state is carried by system colours and shape: the
     current node takes a 2px Highlight frame, the dots keep their states, and the lines stay drawn. */
  @media (forced-colors: active) {
    .ap-node[data-state='active'] {
      border: 2px solid Highlight;
      padding: calc(0.62rem - 1px) calc(0.72rem - 1px);
    }
    .ap-node[data-state='future'] { border-style: dashed; }
    .ap-dot::before { forced-color-adjust: none; background: GrayText; }
    .ap-dot[data-state='done']::before { background: CanvasText; }
    .ap-dot[data-state='active']::before { background: Highlight; }
    .ap-conn-svg { forced-color-adjust: none; }
    .ap-conn-base { stroke: GrayText; opacity: 1; }
    .ap-conn-live, .ap-conn-head { stroke: CanvasText; }
    .ap-conn[data-state='current'] :is(.ap-conn-live, .ap-conn-head) { stroke: Highlight; }
    .ap-fade, .ap-runner { display: none; }
  }

  /* On paper the stepper cannot be stepped: the dossier lists every hop and the strip and controls step
     aside, whatever step the page was on. */
  @media print {
    .apath { box-shadow: none; }
    .ap-meter, .ap-stage, .ap-foot { display: none; }
    .ap-panel {
      grid-area: auto;
      grid-column: 1 / -1;
      break-inside: avoid;
    }
    .ap-panel[hidden] { visibility: visible; }
    .ap-panel + .ap-panel { margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--ap-line); }
  }

  /* Narrow screens: scrolling the path is the deliberate gesture, matching how code blocks scroll. A
     phone held sideways keeps the phone's rules at any width (chrome.css, "A phone held sideways"). */
  @media (max-width: 50rem), (height <= 30rem) and (hover: none) {
    /* The band narrows on small screens (less of a scarce 318px stage spent on mask), and because the
       gutter reads the same token it narrows with it, so the endpoints stay exactly as clear as on desktop. */
    .apath { padding-inline: 0.75rem; --ap-fade-w: 24px; }
    /* The width crescendo tops out earlier, so on a phone the current node and the hop that reached it fit
       in one frame together, the goal included. */
    .ap-node { width: min(calc(148px + var(--t) * 56px), 176px); }
    .ap-foot { flex-wrap: wrap; }
  }
</style>
