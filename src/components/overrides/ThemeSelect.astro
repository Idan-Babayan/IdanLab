---
// src/components/overrides/ThemeSelect.astro
//
// REPLACING override of Starlight's ThemeSelect, the exception CORE_SPEC "Starlight Component
// Overrides" allows when nothing additive can do the job (approved by the owner, 2026-10-18). Starlight's
// control is a Dark/Light/Auto select, and the bar wants About's single-click toggle: no CSS turns a
// select into a button, and a button beside a hidden select would leave two controls for one setting.
// No Starlight plugin claims ThemeSelect (checked 2026-10-18: starlight-image-zoom claims MarkdownContent
// only). Starlight renders this component twice, in the header and in the phone menu's footer, and both
// copies are this button, kept in sync by the one script below. It imports nothing from Starlight.
//
// It mirrors About's toggle (about.astro, .theme-toggle): the same two icons, named for the theme it
// turns on ("Light theme"), with aria-pressed true while paper is on. Size, hit area and colours live in
// chrome.css. Starlight's ThemeProvider still sets the theme before first paint; this only flips it and
// stores the choice under Starlight's own key, which About reads too. With no stored choice (none, or
// the empty string Starlight wrote for Auto) the page keeps following the system, live, until the
// first click makes the choice explicit.
---

<button class="theme-toggle" type="button" aria-label="Light theme" aria-pressed="false" data-theme-toggle>
  <svg class="ico ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  <svg class="ico ico-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
</button>

<script>
  type Theme = 'dark' | 'light';

  const STORAGE_KEY = 'starlight-theme';
  const root = document.documentElement;
  const systemLight = window.matchMedia('(prefers-color-scheme: light)');

  const current = (): Theme => (root.dataset.theme === 'light' ? 'light' : 'dark');

  const storedChoice = (): Theme | null => {
    try {
      const value = localStorage.getItem(STORAGE_KEY);
      return value === 'dark' || value === 'light' ? value : null;
    } catch {
      return null;
    }
  };

  // Every copy (the header's and the phone menu's) reports the same state. The icons follow
  // data-theme in CSS, so only aria-pressed needs writing.
  const sync = (): void => {
    const pressed = String(current() === 'light');
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
      button.setAttribute('aria-pressed', pressed);
    }
  };

  const apply = (theme: Theme): void => {
    root.dataset.theme = theme;
    sync();
  };

  // One listener for both copies. Enter and Space on a button arrive as clicks too.
  document.addEventListener('click', (event: MouseEvent) => {
    const target = event.target;
    if (!(target instanceof Element) || target.closest('[data-theme-toggle]') === null) return;
    const next: Theme = current() === 'light' ? 'dark' : 'light';
    apply(next);
    try {
      localStorage.setItem(STORAGE_KEY, next);
    } catch {
      // Storage unavailable: the choice holds for this page only.
    }
  });

  // No stored choice: follow the system as it changes, as Starlight's own picker did on Auto.
  systemLight.addEventListener('change', () => {
    if (storedChoice() === null) apply(systemLight.matches ? 'light' : 'dark');
  });

  sync();
</script>
