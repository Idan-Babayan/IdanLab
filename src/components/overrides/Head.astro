---
// src/components/overrides/Head.astro
//
// Additive override of Starlight's Head (approved pattern, alongside PageSidebar and MarkdownContent).
// Renders <Default /> untouched, then appends ONLY the social tags Starlight does not emit.
//
// Starlight (0.41.10 today, 0.40 when this was written) already emits, per page: og:title, og:type,
// og:url, og:locale, og:description, og:site_name and twitter:card. Re-declaring any of those here
// would duplicate them, so this file adds only the ten that are missing: author; og:image and its
// secure_url, type, width, height and alt; twitter:image, twitter:title and twitter:description.
//
// twitter:title / twitter:description are taken from the page's own frontmatter so they track the
// per-page values Starlight already puts in og:title / og:description, rather than pinning a constant
// site-wide string over every page. Falling back to the site title and description keeps pages that
// declare neither correct.
//
// og:image is absolute because crawlers do not resolve relative paths. new URL() against Astro.site
// (astro.config.mjs `site`) is what makes it absolute without hardcoding the origin twice.
import Default from '@astrojs/starlight/components/Head.astro';

const { entry, siteTitle } = Astro.locals.starlightRoute;
const SITE_DESCRIPTION =
  'Curiosity is my exploit. A living lab notebook of machine walkthroughs and capture-the-flag solutions by Idan Babayan.';

const title = (entry.data.title as string | undefined) ?? siteTitle;
const description = (entry.data.description as string | undefined) ?? SITE_DESCRIPTION;
const image = new URL('/og.jpg', Astro.site).href;

// The site had no author metadata at all: third-party scrapers read it back as
// null and LinkedIn's inspector reported "no author found". Starlight does not
// emit one, so it is added here for docs and inline on the two marketing pages.
const AUTHOR = 'Idan Babayan';
const OG_ALT = 'Idan.Lab, a lab notebook of CTF writeups and security notes';
---

<Default><slot /></Default>
<meta name="author" content={AUTHOR} />
<meta property="og:image" content={image} />
<meta property="og:image:secure_url" content={image} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={OG_ALT} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
